# ---------------------------------------------------------------------------
# Backend configuration (copy to .env; .env is git-ignored)
# ---------------------------------------------------------------------------

# --- Supabase Postgres -----------------------------------------------------
# Use the direct connection (port 5432) or the session pooler.
# If you use the transaction pooler (port 6543), the backend automatically sets
# asyncpg statement_cache_size=0.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Supabase auth ---------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Legacy projects (HS256): paste the JWT secret from
# Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=

# New projects (asymmetric keys): leave SUPABASE_JWT_SECRET empty and point at
# the JWKS endpoint. The default is ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUDIENCE=authenticated

# --- MQTT ------------------------------------------------------------------
# Use localhost when the broker runs on the same machine as the backend.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=relayboard
MQTT_PASSWORD=change-me
MQTT_TOPIC_PREFIX=boards
MQTT_QOS=1
# MQTT_CLIENT_ID=relayboard-backend

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Optional tuning -------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
# READINGS are batched; these are the defaults.
# READING_BATCH_MAX_SIZE=100
# READING_BATCH_FLUSH_INTERVAL=0.2
# DATABASE_POOL_SIZE=5
